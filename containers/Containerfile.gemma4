# Gemma 4 training image — DeepRed-Phase4-Plan.md P1.2.
#
# Built alongside strix-halo-finetuning, never over it. The working image is
# the only thing standing between Phase 4 and a lost Phase 1-3 training path,
# so the upgrade lands in a fork and is proven before anything depends on it.
FROM docker.io/kyuz0/amd-strix-halo-llm-finetuning:latest

# google/gemma-4-12B-it declares transformers_version 5.10.0.dev0 and
# model_type gemma4_unified; the 4.57.x in the base image cannot load it.
ARG TRANSFORMERS_VERSION=5.17.0

# The base image carries a gfx1151 ROCm torch built from AMD's nightly index,
# which no public PyPI index can supply. Pin it as a constraint so a resolver
# that wants to move it fails the build here, rather than swapping in a CPU
# wheel that only shows up later as a silently unusable GPU.
RUN set -eux; \
    TORCH="$(/opt/venv/bin/python3 -c 'import torch; print(torch.__version__)')"; \
    echo "torch==${TORCH}" > /tmp/constraints.txt; \
    /opt/venv/bin/pip install --no-cache-dir \
        --constraint /tmp/constraints.txt \
        "transformers==${TRANSFORMERS_VERSION}"; \
    rm -f /tmp/constraints.txt; \
    /opt/venv/bin/python3 - "$TORCH" <<'PY'
import sys
import torch
import transformers
expected = sys.argv[1]
if torch.__version__ != expected:
    raise SystemExit(
        f'torch changed during the transformers upgrade: '
        f'{expected} -> {torch.__version__}')
print('torch       :', torch.__version__)
print('transformers:', transformers.__version__)
from transformers.models.auto.configuration_auto import CONFIG_MAPPING_NAMES
if 'gemma4_unified' not in CONFIG_MAPPING_NAMES:
    raise SystemExit(
        f'transformers {transformers.__version__} has no gemma4_unified config')
print('gemma4_unified: present')
PY
