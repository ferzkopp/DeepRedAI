# Wikipedia MCP Server systemd service
# Paths are derived from DEEPRED_ROOT. Adjust the Environment lines below
# if your data disk is mounted somewhere other than /mnt/data.
# See deepred-env.sh for the canonical variable definitions.

[Unit]
Description=Wikipedia MCP Server
After=network.target opensearch.service postgresql.service

[Service]
Type=simple
User=wiki
Group=wiki
Environment="DEEPRED_ROOT=/mnt/data"
Environment="WIKI_DATA=/mnt/data/wikipedia"
WorkingDirectory=/mnt/data/wikipedia/scripts
ExecStart=/mnt/data/venv/bin/uvicorn mcp_server:app --host 0.0.0.0 --port 7000
Restart=on-failure

[Install]
WantedBy=multi-user.target
