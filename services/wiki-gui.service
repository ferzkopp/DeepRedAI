# Wikipedia Web GUI systemd service
# Paths are derived from DEEPRED_ROOT. Adjust the paths below
# if your data disk is mounted somewhere other than /mnt/data.
# See deepred-env.sh for the canonical variable definitions.

[Unit]
Description=Wikipedia Web GUI
After=network.target mcp.service

[Service]
Type=simple
User=wiki
Group=wiki
WorkingDirectory=/mnt/data/wikipedia/frontend
ExecStart=/usr/bin/npm run preview
Restart=on-failure
Environment="NODE_ENV=production"

[Install]
WantedBy=multi-user.target
